# Copy to .env (git-ignored) and edit. Read by scripts/set-domain.py, which writes the domain into the lab files.
# The lab's domain: staff addresses are name@<this domain> (for example priya.raman@boab.lab). Choose it BEFORE you build.
LAB_DOMAIN=boab.lab
# Optional: the short Windows domain name (1 to 15 letters, digits or hyphens). Default: the first label in capitals.
#LAB_NETBIOS=BOAB

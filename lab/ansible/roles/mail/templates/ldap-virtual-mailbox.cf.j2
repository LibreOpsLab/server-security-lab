# Managed by Ansible (role: mail). A recipient is valid only if it matches the mail attribute of a directory user.
server_host = {{ lab_ldap_uri }}
version = 3
bind = yes
bind_dn = CN={{ lab_mail_account }},{{ lab_service_dn }}
bind_pw = {{ lookup('ansible.builtin.file', lab_secrets_dir ~ '/mail_ldap_bind_password') }}
search_base = {{ lab_users_dn }}
scope = sub
query_filter = (&(objectClass=person)(mail=%s))
result_attribute = sAMAccountName
tls_ca_cert_file = /etc/ssl/certs/ca-certificates.crt

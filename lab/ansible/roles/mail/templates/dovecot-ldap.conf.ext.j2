# Managed by Ansible (role: mail). Dovecot checks passwords by binding to Samba AD as the user.
uris = {{ lab_ldap_uri }}
tls_ca_cert_file = /etc/ssl/certs/ca-certificates.crt
dn = CN={{ lab_mail_account }},{{ lab_service_dn }}
dnpass = {{ lookup('ansible.builtin.file', lab_secrets_dir ~ '/mail_ldap_bind_password') }}
auth_bind = yes
auth_bind_userdn = %n@{{ lab_domain }}
base = {{ lab_users_dn }}
scope = subtree
pass_filter = (&(objectClass=person)(sAMAccountName=%n))

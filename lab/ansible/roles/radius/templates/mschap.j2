# Managed by Ansible (role: radius). Password checks go to the domain through winbind's ntlm_auth, and only
# members of the "wifi" group may log in to the wireless network.
mschap {
    use_mppe = yes
    require_encryption = yes
    require_strong = yes
    with_ntdomain_hack = yes
    ntlm_auth = "/usr/bin/ntlm_auth --request-nt-key --username=%{%{Stripped-User-Name}:-%{%{User-Name}:-None}} --challenge=%{%{mschap:Challenge}:-00} --nt-response=%{%{mschap:NT-Response}:-00} --domain={{ lab_netbios }} --require-membership-of={{ lab_netbios }}\\\\wifi"
}
